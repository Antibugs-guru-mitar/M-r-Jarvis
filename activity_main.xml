<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:id="@+id/jarvisRoot"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="#02050A"

    android:fitsSystemWindows="false"

    tools:context=".MainActivity">


    <!-- =====================================================
         JARVIS WEB INTERFACE
         =====================================================

         Existing:
             index.html
             style.css
             script.js

         will be loaded inside this WebView.

         Android native layer:
             MainActivity
             AndroidBridge
             JarvisService
             CommandRouter

         communicates with this interface.
         ===================================================== -->

    <WebView

        android:id="@+id/jarvisWebView"

        android:layout_width="match_parent"
        android:layout_height="match_parent"

        android:background="#02050A"

        android:scrollbars="none"

        android:overScrollMode="never"

        android:fadeScrollbars="false"

        android:scrollbarStyle="outsideOverlay"

        android:importantForAccessibility="yes"

        android:contentDescription="JARVIS AI Assistant Interface"

        android:keepScreenOn="false"

        android:fitsSystemWindows="false"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        tools:ignore="WebViewLayout" />


    <!-- =====================================================
         OPTIONAL ANDROID LOADING LAYER
         =====================================================

         This remains hidden during normal operation.

         MainActivity can show it later while the JARVIS
         interface is loading.
         ===================================================== -->

    <FrameLayout

        android:id="@+id/loadingLayer"

        android:layout_width="match_parent"
        android:layout_height="match_parent"

        android:background="#02050A"

        android:visibility="gone"

        android:clickable="false"
        android:focusable="false"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <LinearLayout

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_gravity="center"

            android:gravity="center"

            android:orientation="vertical">


            <!-- JARVIS loading indicator -->

            <ProgressBar

                android:id="@+id/jarvisLoading"

                android:layout_width="42dp"
                android:layout_height="42dp"

                android:indeterminate="true" />


            <TextView

                android:id="@+id/loadingText"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="18dp"

                android:text="INITIALIZING JARVIS..."

                android:textColor="#69EFFF"

                android:textSize="13sp"

                android:fontFamily="monospace"

                android:letterSpacing="0.08"

                android:gravity="center" />

        </LinearLayout>

    </FrameLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
